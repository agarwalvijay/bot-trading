[Unit]
Description=Polymarket Arb Web Dashboard
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/polymarket_arb
EnvironmentFile=/home/YOUR_USER/polymarket_arb/.env
ExecStart=/home/YOUR_USER/polymarket_arb/venv/bin/gunicorn \
    --bind 127.0.0.1:8080 \
    --workers 1 \
    --timeout 30 \
    web:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
