[Unit]
Description=Polymarket Arbitrage Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/polymarket_arb
EnvironmentFile=/home/YOUR_USER/polymarket_arb/.env
ExecStart=/home/YOUR_USER/polymarket_arb/venv/bin/python arb_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# Give it time to flush on shutdown
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
