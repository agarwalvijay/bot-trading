# ── Kalshi Production API ─────────────────────────────────────────────────────
# Generate at: https://kalshi.com/account/api-keys
KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem   # path to your RSA PEM file

# ── Kalshi Demo API (separate account at demo.kalshi.co) ──────────────────────
# Generate at: https://demo.kalshi.co/account/api-keys
DEMO_API_KEY_ID=your-demo-api-key-id-here
DEMO_PRIVATE_KEY_PATH=kalshi_demo_private_key.pem

# ── Scanning ──────────────────────────────────────────────────────────────────
MARKET_REFRESH_INTERVAL=300    # seconds between full market list refreshes
REST_POLL_INTERVAL=10          # seconds between REST polling cycles
MAX_MARKETS=0                  # 0 = no cap, fetch all open markets
MARKET_PAGE_SIZE=1000          # markets per Kalshi API page (max 1000)
BOOK_BATCH_SIZE=200            # tickers per GET /markets?tickers= batch
MAX_WS_MARKETS=500             # max tickers in WS subscription
WS_FRESHNESS_SECS=60           # WS-fresh markets skipped by REST poller
MAX_REST_MARKETS=2500          # max markets polled per REST cycle
NEAR_TERM_SCAN_INTERVAL=900    # seconds between near-term discovery scans (15 min)
NEAR_TERM_HORIZON_HOURS=12     # hours ahead to scan for new near-term markets (sports etc.)

# ── Fee model ─────────────────────────────────────────────────────────────────
TAKER_FEE_COEFF=0.07           # Kalshi taker: 0.07 × price × (1 - price)

# ── Arb filters ───────────────────────────────────────────────────────────────
MIN_NET_PROFIT=0.005           # 0.5% minimum net profit after fees
MIN_LEG_SIZE=50.0              # minimum contracts at best ask per leg
MIN_LEG_PRICE=0.01             # skip legs priced below 1¢ (near-certain outcome)
NEAR_MISS_LOWER=-0.02          # log near-misses down to -2% net
MIN_MULTI_OUTCOME_SUM=0.85     # min sum for 5+ outcome events (filters non-exhaustive rankings)
MIN_VOLUME_24H=0               # skip markets with less than this 24h volume (0 = off)

# ── Alerts ────────────────────────────────────────────────────────────────────
WS_ALERT_COOLDOWN_SECS=60
WS_MIN_PROFIT_IMPROVEMENT=0.005
EXPIRING_SOON_MINS=30
EXPIRING_ACTIONABLE_MIN_PROFIT=0.01

# ── Telegram (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_PROFIT=0.01

# ── Database ──────────────────────────────────────────────────────────────────
# When DEMO_MODE=true, defaults to arb_opportunities_demo.db automatically.
# Override here only if you want a custom path.
# DB_PATH=arb_opportunities.db

# ── Trading execution ─────────────────────────────────────────────────────────
TRADING_ENABLED=false          # set true to enable order placement
DEMO_MODE=true                 # true = scan AND trade on demo-api.kalshi.co

# Demo API URLs (used for ALL API calls when DEMO_MODE=true)
DEMO_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
DEMO_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2

MAX_CONTRACTS_PER_TRADE=50     # hard cap per leg
MAX_TRADE_COST=100.0           # max total spend per trade (all legs); set to your balance
MAX_LEG_DRIFT=0.02             # abort if price moved >2¢ since detection
FILL_TIMEOUT_SECS=30           # wait for fill confirmation
UNWIND_RETRY_DELAY_SECS=5      # pause before retry attempt on leg B failure
UNWIND_LIMIT_TIMEOUT_SECS=60   # limit-sell window before escalating to market
ALLOW_DIRECTIONAL_HOLD=false   # hold unhedged leg as directional (dangerous)
TRADE_POLL_INTERVAL=5          # seconds between trading loop ticks

# ── Early settlement ───────────────────────────────────────────────────────────
SETTLE_ENABLED=false           # set true to enable early-exit of complete trades
SETTLE_POLL_INTERVAL=60        # seconds between settle checks
SETTLE_MIN_PROFIT_RATIO=0.5    # exit early if bids yield >= 50% of theoretical net profit
SETTLE_SKIP_IF_EXPIRY_MINS=30  # skip settle check if market closes within this many minutes
