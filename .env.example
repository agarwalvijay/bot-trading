# ── Kalshi API ────────────────────────────────────────────────────────────────
# Generate at: https://kalshi.com/account/api-keys
KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem   # path to your RSA PEM file

# Use demo API for testing (no real money):
# KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
# KALSHI_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2

# ── Scanning ──────────────────────────────────────────────────────────────────
MARKET_REFRESH_INTERVAL=300    # seconds between full market list refreshes
REST_POLL_INTERVAL=10          # seconds between REST polling cycles
MAX_MARKETS=0                  # 0 = no cap, fetch all open markets
MARKET_PAGE_SIZE=1000          # markets per Kalshi API page (max 1000)
BOOK_BATCH_SIZE=200            # tickers per GET /markets?tickers= batch
MAX_WS_MARKETS=500             # max tickers in WS subscription
WS_FRESHNESS_SECS=60           # WS-fresh markets skipped by REST poller
MAX_REST_MARKETS=2500          # max markets polled per REST cycle

# ── Fee model ─────────────────────────────────────────────────────────────────
TAKER_FEE_COEFF=0.07           # Kalshi taker: 0.07 × price × (1 - price)

# ── Arb filters ───────────────────────────────────────────────────────────────
MIN_NET_PROFIT=0.005           # 0.5% minimum net profit after fees
MIN_LEG_SIZE=50.0              # minimum contracts at best ask per leg
MIN_LEG_PRICE=0.01             # skip legs priced below 1¢ (near-certain outcome)
NEAR_MISS_LOWER=-0.02          # log near-misses down to -2% net
MIN_MULTI_OUTCOME_SUM=0.85     # min sum for 5+ outcome events (filters non-exhaustive rankings)

# ── Alerts ────────────────────────────────────────────────────────────────────
WS_ALERT_COOLDOWN_SECS=60
WS_MIN_PROFIT_IMPROVEMENT=0.005
EXPIRING_SOON_MINS=30
EXPIRING_ACTIONABLE_MIN_PROFIT=0.01

# ── Telegram (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_PROFIT=0.01

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=arb_opportunities.db
