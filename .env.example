# ── API endpoints (defaults are fine for mainnet) ────────────────────────────
CLOB_BASE_URL=https://clob.polymarket.com
GAMMA_BASE_URL=https://gamma-api.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ── Scanning behaviour ───────────────────────────────────────────────────────
MARKET_REFRESH_INTERVAL=300   # seconds between full market list refreshes
REST_POLL_INTERVAL=10          # seconds between REST order-book polls
MAX_MARKETS=0                  # 0 = no cap (fetch all ~38k active CLOB markets); set e.g. 5000 to cap
GAMMA_PAGE_SIZE=500            # markets per Gamma API page (max 500)
MAX_WS_TOKENS=1000             # WS subscription cap (~55k tokens crashes the connection)
MAX_REST_MARKETS=2500          # REST-poll top N markets per cycle (2500 * 2 / 100 = ~50 calls/cycle)
BOOK_BATCH_SIZE=100            # token order books fetched per REST request

# ── Arbitrage filters ────────────────────────────────────────────────────────
FEE_RATE=0.02                  # 2 % taker fee per leg
MIN_NET_PROFIT=0.005           # 0.5 % minimum net profit after fees to alert
MIN_LEG_SIZE=5.0               # minimum USDC liquidity required on each outcome

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=arb_opportunities.db

# ── Telegram alerting (leave blank to disable) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_PROFIT=0.01       # only send Telegram alerts above this threshold

# ── Phase 2: order execution credentials (not needed for monitoring only) ────
POLY_ADDRESS=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
PRIVATE_KEY=                   # Polygon private key for L1 signing
